{
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "pyproject.toml"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/v2/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/v2/internal/artifacts/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/v2/internal/video/recover",
      "schedule": "*/5 * * * *"
    }
  ]
}
