{
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "pyproject.toml"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/embed/generation/(.*)", "destination": { "service": "backend" } },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/v2/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    { "source": "/((?!embed/generation/).*)", "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }, { "key": "X-Frame-Options", "value": "DENY" }] },
    { "source": "/assets/embed.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/style.css", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "crons": [
    {
      "path": "/v2/internal/artifacts/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/v2/internal/video/recover",
      "schedule": "*/5 * * * *"
    }
  ]
}
