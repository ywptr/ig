# --------------------------------------------------
# Tenant secrets
# --------------------------------------------------

# Fernet key used to encrypt tenant provider
# credentials before storing them in the database.
#
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# For Vercel deployments, configure this as a Vercel environment variable.
#
# Do not commit the generated value into git.
TENANT_SECRET_ENCRYPTION_KEY=<please generate as per instructions above>

# --------------------------------------------------
# Database
# --------------------------------------------------

# SQLAlchemy database connection string. You will get this string once Neon database is provisioned by Vercel.
#
# Recommended deployment:
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# --------------------------------------------------
# Job Queue
# --------------------------------------------------

# Queue backend used by the application.
#
# Supported values: vercel, rq
#
# "vercel" is the standard V3 deployment path.
# "rq" is an optional Redis-backed alternative. It requires a separately hosted Redis instance and RQ worker process.
JOB_QUEUE_PROVIDER=vercel

# --------------------------------------------------
# Redis / RQ — OPTIONAL
# --------------------------------------------------

# Required only when JOB_QUEUE_PROVIDER=rq.
# A separate long-running RQ worker is also required.
# REDIS_URL=rediss://default:password@redis-provider.example.com:6379

# --------------------------------------------------
# Vercel Queue
# --------------------------------------------------

# Vercel Queue is the recommended queue backend for normal
# IG deployments on Vercel.
#
# Production Vercel deployments do not require REDIS_URL or
# a separately hosted RQ worker.
#
# IG_QUEUE_BASE_URL is only required when running the standalone
# Vercel Queue development server locally.
#
# Local development example:
#
# IG_QUEUE_BASE_URL=http://127.0.0.1:4790
#
# Vercel runtime values such as VERCEL_OIDC_TOKEN and VERCEL_REGION
# are normally supplied by Vercel and should not be committed here.

# --------------------------------------------------
# Artifact Storage
# --------------------------------------------------

# Artifact storage backend.
#
# Supported values:
#   local   -> local filesystem
#   vercel  -> Vercel Blob
#
# Local development default:
# ARTIFACT_STORE_PROVIDER=local
#
# Cloud deployment default:
ARTIFACT_STORE_PROVIDER=vercel


# --------------------------------------------------
# Logging / Tracing
# --------------------------------------------------

# Standard Python application log level.
# Common values: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enables additional queue/job lifecycle tracing.
# Useful when debugging enqueue / worker execution paths.
IG_TRACE_JOBS=false

# --------------------------------------------------
# Identity Service / OIDC
# --------------------------------------------------

# Discovery document URL (required). IG validates issuer from this document;
# IS_OIDC_ISSUER is not read by the current implementation.
IS_OIDC_DISCOVERY_URL=https://<your-is-url>/api/auth/.well-known/openid-configuration

# OIDC client registered for this IG environment.
IS_OIDC_CLIENT_ID=<returned after registering the IG environment in IS>

# Confidential client secret.
# Never expose this to the frontend.
IS_OIDC_CLIENT_SECRET=<returned after registering the IG environment in IS>

# Exact callback URI registered in IS.
IS_OIDC_REDIRECT_URI=https://<your-ig-app-url>/v2/auth/is/callback

# Optional browser destination after login; defaults to /.
IS_OIDC_POST_LOGIN_REDIRECT=/

# Phase 1 supports legacy only; shadow/enforce await the Nexus Consumer API.
NEXUS_TENANCY_MODE=legacy

# Local Docker HTTPS: paths to leaf files kept outside Git; never mount the CA key.
# IG_DEV_TLS_CERT_FILE=/absolute/path/to/ig/dev-cert.pem
# IG_DEV_TLS_KEY_FILE=/absolute/path/to/ig/dev-key.pem

# Docker development only: local PostgreSQL target, independent of host DATABASE_URL.
# IG_DEV_DATABASE_URL=postgresql+psycopg://ig_dev:<local-password>@host.docker.internal:5432/ig_dev


# --------------------------------------------------
# Artifact retention cleanup
# --------------------------------------------------

# Secret authenticating scheduled maintenance requests:
# GET /v2/internal/artifacts/cleanup and GET /v2/internal/video/recover.
# Generate a strong random value; never reuse application/user/provider credentials.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure in Vercel Project Settings > Environment Variables > Production,
# then deploy. Do not commit the generated value. This template is placeholder-only.
# Rotate by generating a replacement, updating Production, deploying, then checking
# the next scheduled request succeeds. See docs/artifact-lifecycle.md.
CRON_SECRET=

# Candidate page size, separate from the total work allowed per invocation.
ARTIFACT_CLEANUP_BATCH_SIZE=50
# Maximum attempted removals per invocation; dry-run caps eligible inspections.
ARTIFACT_CLEANUP_MAX_ITEMS_PER_RUN=500
# Additional run safety bounds. Stop starting new items after the time budget.
# Keep MAX_SECONDS below deployed function duration, with room for in-flight I/O.
ARTIFACT_CLEANUP_SCAN_LIMIT=1000
ARTIFACT_CLEANUP_MAX_SECONDS=240


# Video resiliency (IG#0002). Generic execution policy, never provider credentials.
# Captured once per execution; changing it does not extend pending operations.
VIDEO_MAX_PENDING_SECONDS=7200
VIDEO_POLL_INTERVAL_SECONDS=30
VIDEO_SUBMISSION_LEASE_SECONDS=300
# Separate recovery cron runs every five minutes on supported deployment plans.
VIDEO_RECOVERY_BATCH_SIZE=50
VIDEO_RECOVERY_MAX_ITEMS_PER_RUN=500
VIDEO_RECOVERY_MAX_SECONDS=240
