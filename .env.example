# --------------------------------------------------
# Tenant secrets
# --------------------------------------------------

# Fernet key used to encrypt tenant provider
# credentials before storing them in the database.
#
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# For Vercel deployments, configure this as a Vercel environment variable.
#
# Do not commit the generated value into git.
TENANT_SECRET_ENCRYPTION_KEY=

# --------------------------------------------------
# Database
# --------------------------------------------------

# SQLAlchemy database connection string. You will get this string once Neon database is provisioned by Vercel.
#
# Recommended deployment:
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# --------------------------------------------------
# Job Queue
# --------------------------------------------------

# Queue backend used by the application.
#
# Supported values: vercel, rq
#
# "vercel" is the standard V3 deployment path.
# "rq" is an optional Redis-backed alternative. It requires a separately hosted Redis instance and RQ worker process.
JOB_QUEUE_PROVIDER=vercel

# --------------------------------------------------
# Redis / RQ — OPTIONAL
# --------------------------------------------------

# Required only when JOB_QUEUE_PROVIDER=rq.
# A separate long-running RQ worker is also required.
# REDIS_URL=rediss://default:password@redis-provider.example.com:6379

# --------------------------------------------------
# Vercel Queue
# --------------------------------------------------

# Vercel Queue is the recommended queue backend for normal
# IG deployments on Vercel.
#
# Production Vercel deployments do not require REDIS_URL or
# a separately hosted RQ worker.
#
# IG_QUEUE_BASE_URL is only required when running the standalone
# Vercel Queue development server locally.
#
# Local development example:
#
# IG_QUEUE_BASE_URL=http://127.0.0.1:4790
#
# Vercel runtime values such as VERCEL_OIDC_TOKEN and VERCEL_REGION
# are normally supplied by Vercel and should not be committed here.

# --------------------------------------------------
# Artifact Storage
# --------------------------------------------------

# Artifact storage backend.
#
# Supported values:
#   local   -> local filesystem
#   vercel  -> Vercel Blob
#
# Local development default:
# ARTIFACT_STORE_PROVIDER=local
#
# Cloud deployment default:
ARTIFACT_STORE_PROVIDER=vercel


# --------------------------------------------------
# Logging / Tracing
# --------------------------------------------------

# Standard Python application log level.
# Common values: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enables additional queue/job lifecycle tracing.
# Useful when debugging enqueue / worker execution paths.
IG_TRACE_JOBS=false

# --------------------------------------------------
# Identity Service / OIDC
# --------------------------------------------------

# Canonical IS OIDC issuer.
IS_OIDC_ISSUER=https://sandcastle-auth.vercel.app

# OIDC client registered for this IG environment.
IS_OIDC_CLIENT_ID=METjAolZwzDnCWQtMBBFACSRYawEncOi

# Confidential client secret.
# Never expose this to the frontend.
IS_OIDC_CLIENT_SECRET=aGyAopDwSnWhQQtNcrGfmdJtyDgOCtYG

# Exact callback URI registered in IS.
IS_OIDC_REDIRECT_URI=https://ig-beta-tan.vercel.app/v2/auth/is/callback